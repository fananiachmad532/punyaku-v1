# Optional environment overrides. The app reads config.json by default;
# you can also set these to override behavior without editing the JSON.

# Where downloads land (full path).
# DOWNLOADER_DOWNLOAD_DIR=C:\Users\me\Videos\BatchDownloaderPro

# Path to a Netscape-format cookies file (overrides cookie_browser).
# DOWNLOADER_COOKIE_FILE=C:\path\to\cookies.txt

# Browser to import cookies from: chrome | edge | firefox | brave
# DOWNLOADER_COOKIE_BROWSER=chrome

# Hard cap on parallel downloads.
# DOWNLOADER_MAX_CONCURRENT=3

# Hard cap on bandwidth (bytes per second). 0 means unlimited.
# DOWNLOADER_RATE_LIMIT_BPS=0
